# Copia este archivo como .env y completa los valores reales.
# NUNCA commitees el .env real -- ya está en .gitignore.

# --- Supabase (públicas, usadas en cliente y servidor) ---
SUPABASE_PROJECT_ID=tu-proyecto-id
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=tu-anon-key-publica
VITE_SUPABASE_PROJECT_ID=tu-proyecto-id
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=tu-anon-key-publica

# --- Supabase (secreta, SOLO servidor -- nunca exponer con prefijo VITE_) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Billing Chile: Mercado Pago (solo servidor) ---
# Proveedor canónico de suscripciones Nüva One.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_ENV=test
MERCADOPAGO_WEBHOOK_SECRET=

# --- Stripe (legacy / compatibilidad, solo servidor) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=

# --- WhatsApp / Meta Cloud API (secreta, solo servidor) ---
META_APP_ID=
VITE_META_APP_ID=
META_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
NUVA_WHATSAPP_PHONE_NUMBER_ID=
NUVA_WHATSAPP_ACCESS_TOKEN=

# --- IA (solo servidor) ---
# Primario económico de beta.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_PROVIDER=groq
# Orden de respaldo. Solo se usan proveedores cuyas claves estén configuradas.
AI_FALLBACK_PROVIDERS=lovable,openai
# Fallback independiente opcional.
LOVABLE_API_KEY=
LOVABLE_MODEL=google/gemini-3-flash-preview
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Precios configurables por millón de tokens; útiles para el Control Tower.
GROQ_INPUT_PRICE_PER_MILLION_USD=0.075
GROQ_OUTPUT_PRICE_PER_MILLION_USD=0.3
LOVABLE_INPUT_PRICE_PER_MILLION_USD=0
LOVABLE_OUTPUT_PRICE_PER_MILLION_USD=0
OPENAI_INPUT_PRICE_PER_MILLION_USD=0
OPENAI_OUTPUT_PRICE_PER_MILLION_USD=0

# --- Cron jobs (secreta, protege /api/quotes/follow-up y /api/collections/check-overdue) ---
CRON_SECRET=

# --- General ---
SITE_URL=http://localhost:3000
