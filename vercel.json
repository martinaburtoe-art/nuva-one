{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "redirects": [
    {
      "source": "/finance",
      "destination": "/finance-professional",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/home-cinematic/inventory.mp4",
      "destination": "https://d2ol7oe51mr4n9.cloudfront.net/user_2xnZNWgckgMqJUOALrLVbW5sagq/19149717-4cc2-45dd-be12-02e2b87bb9ee.mp4"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/billing/subscribe/run-charges",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/n8n-delivery",
      "schedule": "30 3 * * *"
    }
  ]
}
